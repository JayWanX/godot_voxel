
# 这是以"模块(module)"方式构建此引擎的 SCons 入口脚本。
# 它必须集成进 Godot 的源码树中才能运行，无法独立执行，详见根目录 `README`。

# env：Godot 引擎编译主环境（含编译器、平台、目标等配置）。
# env_modules：专用于引擎内置模块的编译环境。
Import("env")
Import("env_modules")

import common
import voxel_version

# 生成版本头文件。
voxel_version.generate_version_header()

# 注意：使用 FastNoise2 需要 C++17，且只在 x86 架构下可用。
FAST_NOISE_2_SRC = env["voxel_fast_noise_2"]
if not env["arch"].startswith("x86"):
	# 非 x86 架构下禁用 FastNoise2。
	FAST_NOISE_2_SRC = False

# 复制一份模块专用环境，避免污染共用环境配置。
env_voxel = env_modules.Clone()

if env_voxel["voxel_werror"]:
	# 仅对模块自身代码启用"警告即错误"。
	# 起因是 MSVC 更新会在旧版 Godot 上引发意外新警告，而这些警告极少被回移植修复。
	# 因此不用全局 werror=yes，改用这个独立开关。
	# 参见 https://github.com/godotengine/godot/pull/106634
	if env_voxel.msvc:
		env_voxel.AppendUnique(CCFLAGS=["/WX"])
	else:
		env_voxel.AppendUnique(CCFLAGS=["-Werror"])

# 收集模块所有需要编译的源文件路径，editor_build 控制是否包含编辑器专属代码。
voxel_files = common.get_sources(env_voxel, env.editor_build)

if env["voxel_sqlite"]:
	env_sqlite = env_voxel.Clone()

	# 关闭 SQLite 的警告，因为 Clang 与 `warnings=extra` 下会产生不少警告。
	env_sqlite.disable_warnings()

	# if not env_sqlite.msvc:
	#     env_sqlite.Append(CXXFLAGS=["-Wno-discarded-qualifiers"])

	# TODO 增强：统一 SQLite 在模块构建中的集成方式。
	# 被迫这样做是因为下面这行只适用于 Godot 自身的构建系统！
	env_sqlite.add_source_files(env.modules_sources, ["thirdparty/sqlite/sqlite3.c"])

# FastNoise 2
if FAST_NOISE_2_SRC:
	if not env.msvc:
		# TODO 增强：workaround https://github.com/Auburn/FastNoise2/issues/80
		# FastNoise2 使用了 MSVC 专属的编译指令。
		# 因此需要在调用 FastNoise2 的 SConscript 之前加上该编译选项（FastNoise2 也会包含这些头文件）。
		env_voxel.Append(CXXFLAGS=["-Wno-unknown-pragmas"])

	# 从源码构建。这是最简单的做法，但要求 C++17。
	SConscript("thirdparty/fast_noise_2/SConscript", exports = ["env", "env_voxel"])

	env_voxel.Append(CPPPATH=["thirdparty/fast_noise_2/include"])

	voxel_files += [
		"util/noise/fast_noise_2.cpp"
	]

	if env.editor_build:
		voxel_files += [
			"editor/fast_noise_2/*.cpp"
		]

	if env["voxel_tests"]:
		voxel_files += ["tests/fast_noise_2/*.cpp"]

# Tracy 性能分析库
if env["tracy"]:
	# Tracy 不是 Godot 构建系统的原生特性，因此需要手动定义几项东西。
	env.Append(CPPDEFINES="TRACY_ENABLE")
	env_voxel.Append(CPPDEFINES="TRACY_ENABLE")
	env_voxel.Append(CPPPATH=["#thirdparty/tracy/public"])
	voxel_files += [
		"#thirdparty/tracy/public/TracyClient.cpp"
	]

# 将汇总好的源文件逐一登记进模块源文件列表，供 Godot 构建系统统一编译链接。
for f in voxel_files:
	env_voxel.add_source_files(env.modules_sources, f)
