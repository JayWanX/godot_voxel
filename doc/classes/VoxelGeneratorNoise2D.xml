<?xml version="1.0" encoding="UTF-8" ?>
<class name="VoxelGeneratorNoise2D" inherits="VoxelGeneratorHeightmap" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>
		生成基于噪声的高度图地形的体素生成器。
	</brief_description>
	<description>
	</description>
	<tutorials>
	</tutorials>
	<members>
		<member name="curve" type="Curve" setter="set_curve" getter="get_curve">
			当赋值时，此曲线将改变高度变化的分布，从而可以为生成的形状提供某种"轮廓"。
			默认情况下使用从 0 到 1 的线性曲线。
			假定曲线的定义域从 0 到 1。
		</member>
		<member name="height_range" type="float" setter="set_height_range" getter="get_height_range" overrides="VoxelGeneratorHeightmap" default="200.0" />
		<member name="noise" type="Noise" setter="set_noise" getter="get_noise">
			用于生成高度图的噪声。生成器需要它才能工作。
		</member>
	</members>
</class>
