<?xml version="1.0" encoding="UTF-8" ?>
<class name="VoxelGeneratorFlat" inherits="VoxelGenerator" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../class.xsd">
	<brief_description>
		生成无限平坦地面的体素生成器。
	</brief_description>
	<description>
	</description>
	<tutorials>
	</tutorials>
	<members>
		<member name="channel" type="int" setter="set_channel" getter="get_channel" enum="VoxelBuffer.ChannelId" default="1">
			用于生成地面的通道。使用 [member VoxelBuffer.CHANNEL_SDF] 生成平滑地形，使用其他通道生成方块风地形。
		</member>
		<member name="height" type="float" setter="set_height" getter="get_height" default="0.0">
			地面的高度。
		</member>
		<member name="voxel_type" type="int" setter="set_voxel_type" getter="get_voxel_type" default="1">
			如果 [member channel] 设置为 [constant VoxelBuffer.CHANNEL_SDF] 以外的任何通道，此值将用于填充地面体素，而空气体素将设置为 0。
		</member>
	</members>
</class>
