<?xml version="1.0" encoding="UTF-8" ?>
<class name="VoxelBlockyAttribute" inherits="Resource" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../class.xsd">
	<brief_description>
	</brief_description>
	<description>
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="get_attribute_name" qualifiers="const">
			<return type="StringName" />
			<description>
				获取属性名称。
			</description>
		</method>
		<method name="get_default_value" qualifiers="const">
			<return type="int" />
			<description>
				获取属性的默认取值。
			</description>
