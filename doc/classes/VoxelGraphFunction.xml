			<param index="0" name="node_id" type="int" />
			<param index="1" name="input_index" type="int" />
			<param index="2" name="value" type="Variant" />
			<description>
				设置节点输入在保持未连接时将具有的值。
			</description>
		</method>
		<method name="set_node_default_input_by_name">
			<return type="void" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="input_name" type="String" />
			<param index="2" name="value" type="Variant" />
			<description>
				设置节点输入在保持未连接时将具有的值。输入通过其在编辑器中显示的名称来指定。
			</description>
		</method>
		<method name="set_node_default_inputs_autoconnect">
			<return type="void" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="enabled" type="bool" />
			<description>
				设置没有入站连接的节点输入在图形编译时是否会自动创建默认连接。
			这仅适用于特定节点（例如，2D 或 3D 噪声默认使用 XYZ 输入）。在其他节点上，它没有效果。
			</description>
		</method>
		<method name="set_node_gui_position">
			<return type="void" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="position" type="Vector2" />
			<description>
				设置图形节点的可视位置，即它在编辑器中显示的位置。
			</description>
		</method>
		<method name="set_node_gui_size">
