			<param index="0" name="node_id" type="int" />
			<param index="1" name="size" type="Vector2" />
			<description>
				设置图形节点的可视大小，即它在编辑器中显示的大小。
			</description>
		</method>
		<method name="set_node_name">
			<return type="void" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="name" type="StringName" />
			<description>
				为节点设置自定义名称。
			</description>
		</method>
		<method name="set_node_param">
			<return type="void" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="param_index" type="int" />
			<param index="2" name="value" type="Variant" />
			<description>
				设置节点的参数。参数索引对应于该参数在编辑器中显示的位置。
			</description>
		</method>
		<method name="set_node_param_by_name">
			<return type="void" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="param_name" type="String" />
			<param index="2" name="value" type="Variant" />
			<description>
				使用节点参数在编辑器中显示的名称来设置其参数。
			</description>
		</method>
		<method name="set_node_param_null">
			<return type="void" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="param_index" type="int" />
			<description>
				将节点的参数设置为 null。此方法仅用于规避 Godot 的 UndoRedo 系统的一个问题。建议使用 [method set_node_param]。
			</description>
		</method>
	</methods>
