<?xml version="1.0" encoding="UTF-8" ?>
<class name="VoxelGraphFunction" inherits="Resource" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>
		用于生成或处理一系列 3D 值的图形。
	</brief_description>
	<description>
		包含一个可用于处理一系列值的图形，例如体素位置（当用作生成器的主函数时），或用于在其它图形中复用（如子图形）。
		目前此类只存储图形，无法自行运行实际处理。它通常被嵌入到另一个资源中，由该资源以特定方式使用此图形。
		要使用它生成体素，请参见 [VoxelGeneratorGraph]。
		节点可以从其输出连接到下一个节点的输入。未连接的输入可以具有默认值或默认的隐式连接。
		节点还可以具有“参数”，即每个节点配置的常量。
		节点分为 3 大类：输入（只有输出）、输出（只有输入）以及其他（既有输入也有输出，用于进行某些计算）。
		节点类型使用枚举 [enum VoxelGraphFunction.NodeTypeID] 标识。此枚举不应在持久化场景（如存档文件）中使用，因为其值可能在版本之间发生变化。
		图形只能处理 32 位浮点值。
		节点类型的描述位于图形编辑器的节点对话框中，或参见 [url]https://voxel-tools.readthedocs.io/en/latest/graph_nodes[/url]。
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="add_connection">
			<return type="void" />
			<param index="0" name="src_node_id" type="int" />
			<param index="1" name="src_port_index" type="int" />
			<param index="2" name="dst_node_id" type="int" />
			<param index="3" name="dst_port_index" type="int" />
			<description>
				将一个节点的输出连接到另一个节点的输入。不支持将节点连接到自身，或以某种方式使其回到自身。
			</description>
		</method>
		<method name="can_connect" qualifiers="const">
			<return type="bool" />
			<param index="0" name="src_node_id" type="int" />
			<param index="1" name="src_port_index" type="int" />
			<param index="2" name="dst_node_id" type="int" />
			<param index="3" name="dst_port_index" type="int" />
			<description>
				测试两个端口是否能够连接在一起。
			</description>
		</method>
		<method name="clear">
			<return type="void" />
			<description>
				从图形中移除所有节点。输入和输出定义不会被清除。
			</description>
		</method>
		<method name="create_function_node">
			<return type="int" />
			<param index="0" name="function" type="VoxelGraphFunction" />
			<param index="1" name="position" type="Vector2" />
			<param index="2" name="id" type="int" default="0" />
			<description>
				基于现有图形创建节点（创建"子图形实例"）。
			</description>
		</method>
		<method name="create_node">
			<return type="int" />
			<param index="0" name="type_id" type="int" enum="VoxelGraphFunction.NodeTypeID" />
			<param index="1" name="position" type="Vector2" />
			<param index="2" name="id" type="int" default="0" />
			<description>
				在特定的可视位置创建给定类型的图形节点。
				[code]position[/code] 参数不会影响图形的运行方式，但它有助于整理节点。
				可以指定一个可选的 ID。如果保持为 0，则将自动生成 ID。
				然后此函数返回节点的 ID，这可能有助于稍后修改节点的其它属性。
			</description>
		</method>
		<method name="find_node_by_name" qualifiers="const">
			<return type="int" />
			<param index="0" name="name" type="StringName" />
			<description>
				查找具有指定名称的节点并返回其 ID。如果未找到节点，则返回 0。
			</description>
		</method>
		<method name="get_connections" qualifiers="const">
			<return type="Array" />
			<description>
				获取描述节点之间所有连接的数组。
			该数组具有以下格式：
				[codeblock]
				[
					{
						"src_node_id": int,
						"src_port_index": int,
						"dst_node_id": int,
						"dst_port_index": int
					},
					...
				]
				[/codeblock]
			</description>
		</method>
		<method name="get_node_default_input" qualifiers="const">
			<return type="Variant" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="input_index" type="int" />
			<description>
			获取指定节点输入端口的默认值。
		</description>
		</method>
		<method name="get_node_default_inputs_autoconnect" qualifiers="const">
			<return type="bool" />
			<param index="0" name="node_id" type="int" />
			<description>
			节点的默认输入是否自动连接。
		</description>
		</method>
		<method name="get_node_gui_position" qualifiers="const">
			<return type="Vector2" />
			<param index="0" name="node_id" type="int" />
			<description>
				获取节点在图形编辑器中的位置。
			</description>
		</method>
		<method name="get_node_gui_size" qualifiers="const">
			<return type="Vector2" />
			<param index="0" name="node_id" type="int" />
			<description>
				获取节点在图形编辑器中的大小。
			</description>
		</method>
		<method name="get_node_ids" qualifiers="const">
			<return type="PackedInt32Array" />
			<description>
				获取图形中所有节点的 ID 列表。
			注意：添加或移除节点后，ID 的返回顺序不保证保持不变。
			</description>
		</method>
		<method name="get_node_input_index" qualifiers="const">
			<return type="int" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="input_name" type="String" />
			<description>
				根据输入的名称获取节点的输入索引。
			</description>
		</method>
		<method name="get_node_name" qualifiers="const">
			<return type="StringName" />
			<param index="0" name="node_id" type="int" />
			<description>
				获取节点的用户自定义名称。
			</description>
		</method>
		<method name="get_node_output_index" qualifiers="const">
			<return type="int" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="output_name" type="String" />
			<description>
				根据输出的名称获取节点的输出索引。
			</description>
		</method>
		<method name="get_node_param" qualifiers="const">
			<return type="Variant" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="param_index" type="int" />
			<description>
				获取节点的参数。参数索引对应于该参数在编辑器中出现的位置。
			</description>
		</method>
		<method name="get_node_type_count" qualifiers="const">
			<return type="int" />
			<description>
				获取图形系统中存在多少种节点类型。
			</description>
		</method>
		<method name="get_node_type_id" qualifiers="const">
			<return type="int" enum="VoxelGraphFunction.NodeTypeID" />
			<param index="0" name="node_id" type="int" />
			<description>
				获取图形中节点类型的 ID。
			</description>
		</method>
		<method name="get_node_type_info" qualifiers="const">
			<return type="Dictionary" />
			<param index="0" name="type_id" type="int" />
			<description>
				从 [enum VoxelGraphFunction.NodeTypeID] 获取关于节点类型的信息。
			返回的数据具有以下结构：
			[codeblock]
			{
				"name": String,
				"inputs": [
					{"name": String},
					...
				],
				"outputs": [
					{"name": String},
					...
				],
				"params": [
					{
						"name": String,
						"type": int (Variant::Type),
						"class_name": String,
						"default_value": Variant
					},
					...
				]
			}
			[/codeblock]
			</description>
		</method>
		<method name="paste_graph_with_pre_generated_ids">
			<return type="void" />
			<param index="0" name="graph" type="VoxelGraphFunction" />
			<param index="1" name="node_ids" type="PackedInt32Array" />
			<param index="2" name="gui_offset" type="Vector2" />
			<description>
				将节点以及它们之间的连接复制到另一个图形中。
			如果节点参数中的资源没有文件路径，它们将被复制。
			如果提供了非零大小的 [code]node_ids[/code]，则定义复制的节点在目标图形中将具有的 ID，顺序与源图形的 [method get_node_ids] 相同。数组的大小必须与复制的节点数量相同，且 ID 不得已在目标图形中存在。如果数组为空，则将自动生成 ID。
			</description>
		</method>
		<method name="remove_connection">
			<return type="void" />
			<param index="0" name="src_node_id" type="int" />
			<param index="1" name="src_port_index" type="int" />
			<param index="2" name="dst_node_id" type="int" />
			<param index="3" name="dst_port_index" type="int" />
			<description>
				移除图形中两个节点之间的现有连接。
			</description>
		</method>
		<method name="remove_node">
			<return type="void" />
			<param index="0" name="node_id" type="int" />
			<description>
				从图形中移除一个节点。
			</description>
		</method>
		<method name="set_expression_node_inputs">
			<return type="void" />
			<param index="0" name="node_id" type="int" />
			<param index="1" name="names" type="PackedStringArray" />
			<description>
				为表达式节点配置输入。[code]names[/code] 是表达式中使用的输入名称列表。
			如果你通过代码创建表达式节点，之后应调用此方法。
			</description>
		</method>
